{
  "openapi": "3.1.0",
  "info": {
    "title": "Api-Desk Whales",
    "version": "2.0.0",
    "description": "Multi-chain whale transfer API (threshold ~> USD): live feed, entity labels, risk score and impact estimate. BASIC/PRO: core whale+stats. ULTRA/MEGA: + timeseries and market analysis. Not a generic price/honeypot aggregator."
  },
