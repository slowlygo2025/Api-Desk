APP_NAME=Api-Desk
APP_ENV=development
API_PREFIX=/v1
SECRET_KEY=change-me-in-production
REQUIRE_API_KEY=false
# Producción recomendada:
# APP_ENV=production
# REQUIRE_API_KEY=true
# ALLOW_CLIENT_REGISTRATION=false
# DATABASE_URL=postgresql+asyncpg://apidesk:apidesk@localhost:5432/apidesk
DATABASE_URL=sqlite+aiosqlite:///./apidesk.db
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

WHALE_THRESHOLD_USD=10000000
THRESHOLD_BTC_USD=10000000
THRESHOLD_ETH_USD=8000000
THRESHOLD_STABLE_USD=10000000
THRESHOLD_ALT_USD=5000000

ALLOW_CLIENT_REGISTRATION=true
PUBLIC_REGISTRATION_PLAN=retail
PANEL_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_TICKET_SECRET=change-me-ws-ticket-secret

# RapidAPI Gateway (Studio → Hub Listing → Gateway → copy Proxy-Secret)
RAPIDAPI_PROXY_SECRET=
# true = solo tráfico con proxy secret (deploy exclusivo Hub)
RAPIDAPI_REQUIRE_PROXY=false
# si APP_ENV=production y hay RAPIDAPI_PROXY_SECRET, exigir proxy
RAPIDAPI_ENFORCE_IN_PRODUCTION=true
# con secret válido, bloquear rutas fuera de la whitelist Hub
RAPIDAPI_HUB_ONLY=true

WORKER_ENABLED=true
WORKER_WHALE_INTERVAL_SEC=45
WORKER_MARKET_INTERVAL_SEC=60
WORKER_CATALOG_INTERVAL_SEC=3600
WORKER_BACKFILL_BLOCKS=200
WORKER_LAG_ALERT_SEC=180

ALCHEMY_API_KEY=
INFURA_API_KEY=
ANKR_API_KEY=
HELIUS_API_KEY=
MEMPOOL_BASE_URL=https://mempool.space/api
BLOCKSTREAM_BASE_URL=https://blockstream.info/api
TRONGRID_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@apidesk.local

RATE_LIMIT_RETAIL=60
RATE_LIMIT_PRO=600
RATE_LIMIT_INSTITUTIONAL=6000
DAILY_QUOTA_RETAIL=5000
DAILY_QUOTA_PRO=100000
DAILY_QUOTA_INSTITUTIONAL=2000000
